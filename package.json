{
  "name": "opencode-mem0-selfhost",
  "version": "0.1.0",
  "type": "module",
  "description": "Mem0 persistent memory plugin for OpenCode — self-host Mem0 REST backend, no cloud SDK, no telemetry by default",
  "main": "dist/index.js",
  "types": "dist/opencode-mem0.d.ts",
  "exports": {
    ".": {
      "types": "./dist/opencode-mem0.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "mem0",
    "memory",
    "ai-memory",
    "persistent-memory",
    "self-host",
    "self-hosted"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/imsudip/opencode-mem0-selfhost.git"
  },
  "bugs": {
    "url": "https://github.com/imsudip/opencode-mem0-selfhost/issues"
  },
  "homepage": "https://github.com/imsudip/opencode-mem0-selfhost#readme",
  "files": [
    "dist",
    "LICENSE",
    "opencode-skills"
  ],
  "scripts": {
    "build": "bun build opencode-mem0.ts --outdir dist --target bun --format esm --entry-naming index.[ext] && tsc --emitDeclarationOnly --outDir dist --declaration",
    "dev": "bun build opencode-mem0.ts --outdir dist --target bun --format esm --entry-naming index.[ext] --watch",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "prepack": "bun run build",
    "postpack": ""
  },
  "opencode": {
    "type": "plugin",
    "hooks": [
      "config",
      "chat.message",
      "tool.execute.before",
      "tool.execute.after",
      "experimental.chat.messages.transform",
      "experimental.session.compacting",
      "shell.env"
    ]
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.162"
  },
  "devDependencies": {
    "bun-types": ">=1.3.14",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  }
}
